<h4>Nieuwe deal aanmaken</h4>

<div class="paper-form-input">
  <iron-icon prefix icon="assignment"></iron-icon>
  {{p-input label="Beschrijving" value=description}}
</div>

<div class="paper-form-input">
  <h2 prefix>#</h2>
  {{p-input label="Aantal" value=amount type="number"}}
</div>

<div class="paper-form-input">
  <iron-icon prefix icon="editor:attach-money"></iron-icon>
  {{p-input label="Kosten" value=cost type="number"}}
</div>

<div class="layout horizontal wrap end-justified">
  <paper-icon-button class="giant" icon="check" {{action "save"}} />
</div>
