<paper-drawer-panel id="drawerPanel">
  <paper-header-panel drawer>
    <paper-toolbar id="navheader" class="tall">
      <iron-image id="coverimage" src="/assets/images/beach.jpg"
            placeholder="/assets/images/beach.jpg"
            sizing="cover" preload fade class="fit"></iron-image>

      {{#if session.isAuthenticated}}
      <img class="middle profile" src={{session.currentUser.profileImageURL}}>
      <div class="bottom layout vertical">
        <span>{{session.currentUser.displayName}}</span>
      </div>
      {{else}}
      Log eerst in!
      {{/if}}
    </paper-toolbar>

    <paper-menu selected="0" selectable="paper-icon-item" on-iron-activate="menuSelect">
      {{#if session.isAuthenticated}}
      <paper-icon-item {{action "navigate" "deals"}} role="menuitem" class="layout horizontal">
        <iron-icon icon="maps:local-atm" item-icon></iron-icon> Deals
      </paper-icon-item>
      <paper-icon-item {{action "navigate" "tasks"}} role="menuitem" class="layout horizontal">
        <iron-icon icon="check-circle" item-icon></iron-icon> Taken
      </paper-icon-item>
      <div class="separator"></div>
      <paper-icon-item {{action "signOut"}} role="menuitem" class="layout horizontal">
        <iron-icon icon="power-settings-new" item-icon></iron-icon> Uitloggen
      </paper-icon-item>
      {{/if}}

    </paper-menu>
  </paper-header-panel>

  <paper-header-panel main>
    <paper-toolbar>
      <paper-icon-button icon="menu" paper-drawer-toggle></paper-icon-button>
      <span class="bottom indent title">Samen Betalen</span>
    </paper-toolbar>
    <div class="outlet">
      {{#if session.isAuthenticated}}
        {{outlet}}
      {{else}}
        <paper-button class="google-sign-in" raised {{action "signIn" "google"}}>
          <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="Google logo" />
          Inloggen
        </paper-button>
      {{/if}}

    </div>
  </paper-header-panel>
</paper-drawer-panel>
