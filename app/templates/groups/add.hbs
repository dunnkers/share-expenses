<h4>Nieuwe groep aanmaken</h4>

<div class="paper-form-input">
  <iron-icon prefix icon="social:people" />
  {{paper-input label="Naam" value=model.name}}
</div>

<div class="paper-form-input">
  <iron-icon prefix icon="communication:comment" />
  {{paper-input label="Beschrijving" value=model.description}}
</div>

<div class="layout horizontal wrap end-justified">
  <paper-icon-button class="giant" icon="check" {{action "save"}} />
</div>
