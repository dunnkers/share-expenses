{{#each model.deals as |deal|}}
  <paper-card class="deal" heading={{deal.description}}>
  <div class="card-content">
    {{deal.description}}
  </div>
  <div class="card-actions">
    <paper-button>Bewerk</paper-button>
    <paper-icon-button icon="date-range">Bewerk</paper-icon-button>
    <span>{{deal.createdAt}}</span>
  </div>
  </paper-card>
{{else}}
  Voeg eerst deals toe!
{{/each}}

{{#link-to 'group.deals.add' tagName="paper-fab" id="fab" icon="add"}}{{/link-to}}
{{!-- <paper-fab id="fab" icon="add" {{action "add"}}></paper-fab> --}}
