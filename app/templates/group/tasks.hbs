<h4>TASKS</h4>
{{#each model.tasks as |task|}}
  {{#unless task.deleted}}
    {{task-checkbox task=task deletedTask=deletedTask}}
  {{/unless}}
{{else}}
  Voeg eerst taken toe!
{{/each}}

{{#paper-input label="Nieuwe taak..." value=description insert-newline="add"}}
  <iron-icon prefix icon="add" />
{{/paper-input}}

{{undo-toast deletedModel=deletedTask text="Taak verwijderd."}}
