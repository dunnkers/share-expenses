{{#each deals as |deal|}}
  {{deal-card deal=deal}}
{{else}}
  <div class="outlet splash-page layout vertical center-center fit">
    <iron-icon icon="editor:attach-money" style="width:120px;height:120px;" />
    <h3>Deals in deze groep komen hier te staan.</h3>
  </div>
{{/each}}

<paper-fab id="fab" icon="add" {{action "addDeal"}} />
