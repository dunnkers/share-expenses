<div class="task-component container">
  <div class="flexchild">
    {{#task-checkbox checked=task.completed task=task}}
    {{task.description}}
    {{/task-checkbox}}
  </div>
  <div>
    {{#if hover}}
      <paper-icon-button icon="cancel" class="delete-task" {{action "delete"}}>
      </paper-icon-button>
    {{/if}}
  </div>
</div>
