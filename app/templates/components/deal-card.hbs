<paper-card class="deal {{if deal.isNew "new"}} {{if isUpdated "updated"}}">
  <div class="card-content">
    {{#if deal.editing}}
      <paper-icon-button class="edit" icon="check-circle" {{action "save"}}>
      </paper-icon-button>
      <paper-icon-button class="edit" icon="block" {{action "cancel"}}>
      </paper-icon-button>

      <div class="paper-form-input">
        <iron-icon prefix icon="assignment"></iron-icon>
        {{paper-input label="Beschrijving" value=deal.description}}
      </div>
    {{else}}
      <div class="layout horizontal">
        <h3 class="flex">{{deal.description}}</h3>
        <paper-icon-button icon="create" {{action "edit"}}>
        </paper-icon-button>
        <paper-icon-button icon="delete" {{action "delete"}}>
        </paper-icon-button>
      </div>
      <h1>(totale kosten)</h1>

      {{#each deal.payments as |payment index|}}
        <div class="layout horizontal end">
          {{#paper-input label="Kosten" value=payment.cost type="number"}}
          <span prefix>€&nbsp;</span>
          {{/paper-input}}
          &nbsp;
          <paper-dropdown-menu label="Betaald door">
            {{#paper-listbox deal.group.users selected=(mut paidBy) as |user|}}
              <paper-item>{{user.title}}</paper-item>
            {{/paper-listbox}}
          </paper-dropdown-menu>
          <paper-icon-button icon="add-circle" {{action "addPayment"}}>
          </paper-icon-button>
          {{#unless (is-first index)}}
            <paper-icon-button icon="clear" {{action "deletePayment" payment}}>
            </paper-icon-button>
          {{/unless}}
        </div>
      {{/each}}
    {{/if}}
    <p>
      <iron-icon icon="event"></iron-icon>
      {{moment-from-now deal.createdAt}} aangemaakt
    </p>
  </div>
  <div class="card-actions">
    <p>
      {{#each deal.participants as |user|}}
        <paper-chip label={{user.title}} removable>
          <iron-icon class="icon" src={{user.avatar}}></iron-icon>
          <h1>{{user.name}}</h1>
          <h2>{{user.email}}</h2>
        </paper-chip>
      {{/each}}
    </p>
  </div>
</paper-card>
