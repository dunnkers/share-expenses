<div class="paper-form-input">
  <iron-icon prefix icon="social:people"></iron-icon>
  {{paper-input label="Groepsnaam" value=group.name required=true auto-validate=true}}
</div>

<div class="titled-separator">
  Personen uitnodigen
</div>
<div class="paper-form-input">
  <iron-icon prefix icon="social:person-add"></iron-icon>
  {{paper-input label="Email adres" type="email" value=invitationEmail
      insert-newline="invite" error-message=error invalid=invalid}}
</div>

{{#if invitations}}
  <h5>Uitgenodigde personen</h5>
{{/if}}
<div role="listbox">
  {{#each invitations as |invitation|}}
    <paper-icon-item class="invitation {{if invitation.isNew "new"}}
    {{if invitation.isDeleted "deleted"}}">
      <iron-icon icon="account-circle" class="avatar" item-icon></iron-icon>
      <paper-item-body class="flex" two-line>
        <div>{{invitation.email}}</div>
        <div secondary>
          {{#unless invitation.loading}}
            Uitnodiging aan het versturen...
          {{else if invitation.failed}}
            Oops, dat was een {{invitation.failure}}.
          {{else if invitation.succeed}}
            {{moment-from-now invitation.date}} uitgenodigd
          {{/unless}}
        </div>
      </paper-item-body>
      {{#unless invitation.loading}}
        <paper-spinner-lite active></paper-spinner-lite>
      {{else if invitation.failed}}
        <iron-icon icon="close" class="error"></iron-icon>
      {{else if invitation.succeed}}
        <iron-icon icon="check" class="success"></iron-icon>
      {{/unless}}
    </paper-icon-item>
  {{/each}}
</div>

{{#unless group.isNew}}
  <p>
    <paper-button raised urgent {{action "leaveGroup"}}>
      Groep verlaten
    </paper-button>
  </p>
{{/unless}}
