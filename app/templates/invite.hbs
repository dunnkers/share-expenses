
<h2>Hé! Je bent uitgenodigd om deel te nemen aan {{group}}!</h2>

{{#if session.isAuthenticated}}
  {{!-- TODO Check whether the currently logged in user already has joined this group --}}
  <a href="http://localhost:3000/verify?uid={{session.uid}}&token={{token}}">
    Deelnemen aan {{group}}!
  </a>
{{else}}
  <p>
    Je zult eerst even moeten inloggen!
  </p>
{{/if}}
