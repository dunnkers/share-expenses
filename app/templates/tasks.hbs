{{#each tasks as |task|}}
  {{#unless task.isDeleted}}
    {{task-checkbox task=task deleted=(action 'deleted')}}
  {{/unless}}
{{else}}
  Voeg eerst taken toe!
{{/each}}

{{#paper-input label="Nieuwe taak..." value=description insert-newline="add"}}
  <iron-icon prefix icon="add"></iron-icon>
{{/paper-input}}

{{!-- Setting the toast duration to 0 disables auto-closing --}}
<paper-toast opened={{opened}} duration=0 text="Taak verwijderd.">
  <paper-button raised {{action "undo"}}>Ongedaan maken</paper-button>
  <paper-icon-button icon="close" {{action "close"}}></paper-icon-button>
</paper-toast>
