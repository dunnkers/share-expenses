{{#each tasks as |task|}}
  {{#unless task.isDeleted}}
    {{task-checkbox task=task deleted=(action 'deletedUndo')}}
  {{/unless}}
{{else}}
  Voeg eerst taken toe!
{{/each}}

{{#p-input label="Nieuwe taak..." value=description insert-newline="add"}}
  <iron-icon prefix icon="add"></iron-icon>
{{/p-input}}

{{#p-toast opened=open duration="10000" text="Taak verwijderd."}}
  <paper-button raised {{action "undo"}}>Ongedaan maken</paper-button>
{{/p-toast}}
